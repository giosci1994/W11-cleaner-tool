<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>W11CleanerTool</RootNamespace>
    <AssemblyName>W11CleanerTool</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Il tema Fluent di Windows 11 (ThemeMode) in WPF è ancora segnato come sperimentale. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- Solo le traduzioni del framework che servono: l'exe resta più piccolo. -->
    <SatelliteResourceLanguages>it;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\W11CleanerTool.Core\W11CleanerTool.Core.csproj" />
  </ItemGroup>

</Project>
