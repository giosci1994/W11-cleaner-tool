<Window x:Class="W11CleanerTool.PreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anteprima modifiche · W11-cleaner-tool"
        Width="700" Height="560" MinWidth="540" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock x:Name="ActionTitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock x:Name="SummaryText" Margin="0,4,0,0" Opacity="0.8" TextWrapping="Wrap" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
      <ItemsControl x:Name="PreviewItemsList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Margin="0,0,0,8" Padding="12" CornerRadius="6" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
              <StackPanel>
                <DockPanel LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Border Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVisibility}}"
                            Margin="6,0,0,0" Padding="6,2" CornerRadius="4" BorderThickness="1" BorderBrush="#D98200">
                      <TextBlock Text="Amministratore" FontSize="11" Foreground="#D98200" />
                    </Border>
                    <Border Visibility="{Binding HasSize, Converter={StaticResource BoolToVisibility}}"
                            Margin="6,0,0,0" Padding="6,2" CornerRadius="4" BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                      <TextBlock Text="{Binding SizeText}" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                  </StackPanel>
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                </DockPanel>

                <TextBlock Text="{Binding BeforeAfterText}" TextWrapping="Wrap" Margin="0,4,0,0" Opacity="0.85"
                           Visibility="{Binding HasBeforeAfter, Converter={StaticResource BoolToVisibility}}" />

                <TextBox Text="{Binding TechnicalDetail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         Margin="0,6,0,0" FontFamily="Consolas" FontSize="11" BorderThickness="0" Background="Transparent"
                         Visibility="{Binding ShowExpertTechnicalDetail, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Margin="0,0,0,14">
      <Border x:Name="AdminWarningBanner" Visibility="Collapsed" Margin="0,0,0,10" Padding="10" CornerRadius="6"
              BorderThickness="4,1,1,1" BorderBrush="#D98200"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                     Foreground="#D98200" Margin="0,2,8,0" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" Text="Alcune voci selezionate richiedono i diritti di amministratore: senza elevazione potrebbero essere saltate."
                     TextWrapping="Wrap" />
        </Grid>
      </Border>

      <CheckBox x:Name="RestorePointCheckBox"
                Content="Crea punto di ripristino prima di applicare"
                FontWeight="SemiBold" />

      <Border x:Name="RestorePointWarningBanner" Visibility="Collapsed" Margin="0,8,0,0" Padding="10" CornerRadius="6"
              BorderThickness="4,1,1,1" BorderBrush="#D98200"
              Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                     Foreground="#D98200" Margin="0,2,8,0" VerticalAlignment="Top" />
          <TextBlock Grid.Column="1" x:Name="RestorePointWarningText" TextWrapping="Wrap" />
        </Grid>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Annulla" Padding="14,7" Margin="0,0,10,0"
              IsCancel="True" Click="CancelButton_Click" />
      <Button x:Name="ConfirmButton" Content="Conferma e applica" Padding="16,7" FontWeight="SemiBold"
              IsDefault="True" Click="ConfirmButton_Click" />
    </StackPanel>
  </Grid>
</Window>
